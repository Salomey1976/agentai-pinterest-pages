# Keep this file as a template. Do not commit .env.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Must exactly match the URI registered in Pinterest Developers.
PINTEREST_REDIRECT_URI=http://localhost:8080/pinterest/callback
# Comma-separated permissions; adjust only to approved Pinterest scopes.
PINTEREST_SCOPES=pins:read,pins:write,boards:read,user_accounts:read
